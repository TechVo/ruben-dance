<?xml version="1.0"?>
<ruleset name="RubenDance">
	<description>Coding standard for the Ruben Dance plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress">
		<!--
			PSR-4 autoloading (required by the implementation plan, §5) needs
			the file name to match the class name exactly, which conflicts
			with WordPress' own "class-{name}.php" file-naming convention.
			Deliberate, documented exception.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ruben-dance"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ruben_dance"/>
				<element value="RubenDance"/>
				<element value="RUBEN_DANCE"/>
			</property>
		</properties>
	</rule>
</ruleset>
